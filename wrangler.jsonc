{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkdrop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LINKDROP_KV",
      "id": "081c2ce8f57a49d99d842e3986f8268c"
    }
  ],
  "observability": {
    "enabled": true
  }
}
